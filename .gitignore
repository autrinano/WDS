# macOS
.DS_Store

# R session and IDE files
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Locally installed R packages
_r_libs/

# Automatically generated plotting artifact
Rplots.pdf

# Microsoft Office temporary lock files
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx

# General temporary files
*.tmp
*.temp

# Run logs from long-running model fits
*_run.log

# Large geospatial archives. These are re-downloadable from stable, versioned
# URLs by diagnose_coc_boundaries_v2.R and build_coc_lasso_panel.R, so they are
# not tracked. The files themselves are preserved locally in raw_data/.
raw_data/*.geojson
raw_data/census_tl_*_tract.zip
raw_data/census_cb_*.zip
county_raw_panel/raw_downloads/*.zip
